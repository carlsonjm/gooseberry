msgid "Inbox"
msgstr "Caixa de entrada"

#: src/core/NoteStore.cpp
msgid "The notes folder %1 could not be made."
msgstr "Não foi possível criar a pasta de notas %1."

#: src/core/NoteStore.cpp
msgid "The notes folder %1 could not be written to."
msgstr "Não foi possível gravar na pasta de notas %1."

#: src/core/NoteStore.cpp
msgid "The notes folder's format file could not be read."
msgstr "Não foi possível ler o arquivo de formato da pasta de notas."

#: src/core/NoteStore.cpp
msgid "This folder was laid out by a newer %1, so nothing in it is changed here."
msgstr "Esta pasta foi organizada por uma versão mais nova de %1, então nada nela é alterado aqui."

#: src/core/NoteStore.cpp
msgid "A folder needs a name."
msgstr "Uma pasta precisa de um nome."

#: src/core/NoteStore.cpp
msgid "A folder's name cannot have a slash in it."
msgstr "O nome de uma pasta não pode conter uma barra."

#: src/core/NoteStore.cpp
msgid "A folder's name cannot start with a dot."
msgstr "O nome de uma pasta não pode começar com um ponto."

#: src/core/NoteStore.cpp
msgctxt "%1 is the folder that holds loose notes"
msgid "%1 is already there."
msgstr "%1 já existe."

#: src/core/NoteStore.cpp
msgid "That name is too long for a folder."
msgstr "Esse nome é longo demais para uma pasta."

#: src/core/NoteStore.cpp
msgid "There is already a folder called %1."
msgstr "Já existe uma pasta chamada %1."

#: src/core/NoteStore.cpp
msgid "The folder %1 could not be made."
msgstr "Não foi possível criar a pasta %1."

#: src/core/NoteStore.cpp
msgid "That folder is no longer there."
msgstr "Essa pasta não existe mais."

#: src/core/NoteStore.cpp
msgid "The folder %1 could not be renamed."
msgstr "Não foi possível renomear a pasta %1."

#: src/core/NoteStore.cpp
msgctxt "%2 is the folder that holds loose notes"
msgid "The folder %1 could not be removed; its notes are in %2."
msgstr "Não foi possível remover a pasta %1; as notas dela estão em %2."

#: src/core/NoteStore.cpp
msgid "That note is no longer in the folder."
msgstr "Essa nota não está mais na pasta."

#: src/core/NoteStore.cpp
msgid "The folder %1 is no longer there."
msgstr "A pasta %1 não existe mais."

#: src/core/NoteStore.cpp
msgid "This note was kept by a newer %1, so it is not changed here."
msgstr "Esta nota foi salva por uma versão mais nova de %1, então não é alterada aqui."

#: src/core/NoteStore.cpp
msgid "The note could not be moved to %1."
msgstr "Não foi possível mover a nota para %1."

#: src/core/NoteStore.cpp
msgid "The workspace's folder could not be kept."
msgstr "Não foi possível guardar a pasta do espaço de trabalho."

#: src/core/NoteStore.cpp
msgid "This folder was kept by a newer %1, so nothing in it is changed here."
msgstr "Esta pasta foi salva por uma versão mais nova de %1, então nada nela é alterado aqui."

#: src/core/NoteStore.cpp
msgid "The note could not be moved to the trash."
msgstr "Não foi possível mover a nota para a lixeira."

#: src/core/NoteStore.cpp
msgid "The note could not be brought back from the trash."
msgstr "Não foi possível trazer a nota de volta da lixeira."

#: src/core/Welcome.cpp
msgctxt "@info welcome note's first line, its title"
msgid "Welcome to %1"
msgstr "Boas-vindas ao %1"

#: src/core/Welcome.cpp
msgctxt "@info welcome note"
msgid "Write anything here. It's kept as you type, with nothing to save."
msgstr "Escreva o que quiser aqui. Tudo é salvo enquanto você digita, sem precisar salvar."

#: src/core/Welcome.cpp
msgctxt "@info welcome note"
msgid "A new note sticks to the window you were using, like a sticky on a page. Tap the dot on that window's title bar to bring it back."
msgstr "Uma nova nota se prende à janela que você estava usando, como um adesivo em uma página. Toque no ponto da barra de título dessa janela para trazê-la de volta."

#: src/core/Welcome.cpp
msgctxt "@info welcome note; keep the # and the word after it as one word, which becomes a folder's name, and use the word for the next day that the note listens for"
msgid "Name a day, like tomorrow, and the note offers to remind you. Put # before a word to keep a note in that folder: #ideas. Lines that start with a dash become a checklist."
msgstr "Mencione um dia, como amanhã, e a nota se oferece para lembrar você. Coloque # antes de uma palavra para guardar uma nota nessa pasta: #ideias. Linhas que começam com um traço viram uma lista de verificação."

#: src/core/Welcome.cpp
msgctxt "@info welcome note"
msgid "Tap the grid below to see all your notes. When you're done with this one, tap More, then Remove."
msgstr "Toque na grade abaixo para ver todas as suas notas. Quando terminar esta, toque em Mais e depois em Remover."

