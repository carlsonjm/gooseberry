msgstr "Boîte de réception"

#: src/core/NoteStore.cpp
msgid "The notes folder %1 could not be made."
msgstr "Le dossier de notes %1 n'a pas pu être créé."

#: src/core/NoteStore.cpp
msgid "The notes folder %1 could not be written to."
msgstr "Impossible d'écrire dans le dossier de notes %1."

#: src/core/NoteStore.cpp
msgid "The notes folder's format file could not be read."
msgstr "Le fichier de format du dossier de notes n'a pas pu être lu."

#: src/core/NoteStore.cpp
msgid "This folder was laid out by a newer %1, so nothing in it is changed here."
msgstr "Ce dossier a été organisé par une version plus récente de %1 ; rien n'y est donc modifié ici."

#: src/core/NoteStore.cpp
msgid "A folder needs a name."
msgstr "Un dossier a besoin d'un nom."

#: src/core/NoteStore.cpp
msgid "A folder's name cannot have a slash in it."
msgstr "Le nom d'un dossier ne peut pas contenir de barre oblique."

#: src/core/NoteStore.cpp
msgid "A folder's name cannot start with a dot."
msgstr "Le nom d'un dossier ne peut pas commencer par un point."

#: src/core/NoteStore.cpp
msgctxt "%1 is the folder that holds loose notes"
msgid "%1 is already there."
msgstr "%1 existe déjà."

#: src/core/NoteStore.cpp
msgid "That name is too long for a folder."
msgstr "Ce nom est trop long pour un dossier."

#: src/core/NoteStore.cpp
msgid "There is already a folder called %1."
msgstr "Il existe déjà un dossier nommé %1."

#: src/core/NoteStore.cpp
msgid "The folder %1 could not be made."
msgstr "Le dossier %1 n'a pas pu être créé."

#: src/core/NoteStore.cpp
msgid "That folder is no longer there."
msgstr "Ce dossier n'existe plus."

#: src/core/NoteStore.cpp
msgid "The folder %1 could not be renamed."
msgstr "Le dossier %1 n'a pas pu être renommé."

#: src/core/NoteStore.cpp
msgctxt "%2 is the folder that holds loose notes"
msgid "The folder %1 could not be removed; its notes are in %2."
msgstr "Le dossier %1 n'a pas pu être supprimé ; ses notes sont dans %2."

#: src/core/NoteStore.cpp
msgid "That note is no longer in the folder."
msgstr "Cette note n'est plus dans le dossier."

#: src/core/NoteStore.cpp
msgid "The folder %1 is no longer there."
msgstr "Le dossier %1 n'existe plus."

#: src/core/NoteStore.cpp
msgid "This note was kept by a newer %1, so it is not changed here."
msgstr "Cette note a été enregistrée par une version plus récente de %1 ; elle n'est donc pas modifiée ici."

#: src/core/NoteStore.cpp
msgid "The note could not be moved to %1."
msgstr "La note n'a pas pu être déplacée vers %1."

#: src/core/NoteStore.cpp
msgid "The workspace's folder could not be kept."
msgstr "Le dossier de l'espace de travail n'a pas pu être conservé."

#: src/core/NoteStore.cpp
msgid "This folder was kept by a newer %1, so nothing in it is changed here."
msgstr "Ce dossier a été enregistré par une version plus récente de %1 ; rien n'y est donc modifié ici."

#: src/core/NoteStore.cpp
msgid "The note could not be moved to the trash."
msgstr "La note n'a pas pu être mise à la corbeille."

#: src/core/NoteStore.cpp
msgid "The note could not be brought back from the trash."
msgstr "La note n'a pas pu être récupérée de la corbeille."

#: src/core/Welcome.cpp
msgctxt "@info welcome note's first line, its title"
msgid "Welcome to %1"
msgstr "Bienvenue dans %1"

#: src/core/Welcome.cpp
msgctxt "@info welcome note"
msgid "Write anything here. It's kept as you type, with nothing to save."
msgstr "Écrivez ce que vous voulez ici. C'est enregistré au fil de la frappe, rien à sauvegarder."

#: src/core/Welcome.cpp
msgctxt "@info welcome note"
msgid "A new note sticks to the window you were using, like a sticky on a page. Tap the dot on that window's title bar to bring it back."
msgstr "Une nouvelle note se colle à la fenêtre que vous utilisiez, comme un pense-bête sur une page. Touchez le point dans la barre de titre de cette fenêtre pour la ramener."

#: src/core/Welcome.cpp
msgctxt "@info welcome note; keep the # and the word after it as one word, which becomes a folder's name, and use the word for the next day that the note listens for"
msgid "Name a day, like tomorrow, and the note offers to remind you. Put # before a word to keep a note in that folder: #ideas. Lines that start with a dash become a checklist."
msgstr "Citez un jour, comme demain, et la note propose de vous le rappeler. Mettez # devant un mot pour ranger une note dans ce dossier : #idées. Les lignes qui commencent par un tiret deviennent une liste de contrôle."

#: src/core/Welcome.cpp
msgctxt "@info welcome note"
msgid "Tap the grid below to see all your notes. When you're done with this one, tap More, then Remove."
msgstr "Touchez la grille ci-dessous pour voir toutes vos notes. Quand vous en avez fini avec celle-ci, touchez Plus, puis Supprimer."

