msgctxt "@title the folder that holds loose notes"
msgid "Inbox"
msgstr "Eingang"

#: src/core/NoteStore.cpp
msgid "The notes folder %1 could not be made."
msgstr "Der Notizordner %1 konnte nicht angelegt werden."

#: src/core/NoteStore.cpp
msgid "The notes folder %1 could not be written to."
msgstr "In den Notizordner %1 konnte nicht geschrieben werden."

#: src/core/NoteStore.cpp
msgid "The notes folder's format file could not be read."
msgstr "Die Formatdatei des Notizordners konnte nicht gelesen werden."

#: src/core/NoteStore.cpp
msgid "This folder was laid out by a newer %1, so nothing in it is changed here."
msgstr "Dieser Ordner wurde von einer neueren Version von %1 angelegt, daher wird hier nichts darin geändert."

#: src/core/NoteStore.cpp
msgid "A folder needs a name."
msgstr "Ein Ordner braucht einen Namen."

#: src/core/NoteStore.cpp
msgid "A folder's name cannot have a slash in it."
msgstr "Der Name eines Ordners darf keinen Schrägstrich enthalten."

#: src/core/NoteStore.cpp
msgid "A folder's name cannot start with a dot."
msgstr "Der Name eines Ordners darf nicht mit einem Punkt beginnen."

#: src/core/NoteStore.cpp
msgctxt "%1 is the folder that holds loose notes"
msgid "%1 is already there."
msgstr "%1 gibt es schon."

#: src/core/NoteStore.cpp
msgid "That name is too long for a folder."
msgstr "Dieser Name ist für einen Ordner zu lang."

#: src/core/NoteStore.cpp
msgid "There is already a folder called %1."
msgstr "Es gibt bereits einen Ordner namens %1."

#: src/core/NoteStore.cpp
msgid "The folder %1 could not be made."
msgstr "Der Ordner %1 konnte nicht angelegt werden."

#: src/core/NoteStore.cpp
msgid "That folder is no longer there."
msgstr "Diesen Ordner gibt es nicht mehr."

#: src/core/NoteStore.cpp
msgid "The folder %1 could not be renamed."
msgstr "Der Ordner %1 konnte nicht umbenannt werden."

#: src/core/NoteStore.cpp
msgctxt "%2 is the folder that holds loose notes"
msgid "The folder %1 could not be removed; its notes are in %2."
msgstr "Der Ordner %1 konnte nicht entfernt werden; seine Notizen liegen in %2."

#: src/core/NoteStore.cpp
msgid "That note is no longer in the folder."
msgstr "Diese Notiz ist nicht mehr im Ordner."

#: src/core/NoteStore.cpp
msgid "The folder %1 is no longer there."
msgstr "Den Ordner %1 gibt es nicht mehr."

#: src/core/NoteStore.cpp
msgid "This note was kept by a newer %1, so it is not changed here."
msgstr "Diese Notiz wurde von einer neueren Version von %1 gespeichert und wird hier daher nicht geändert."

#: src/core/NoteStore.cpp
msgid "The note could not be moved to %1."
msgstr "Die Notiz konnte nicht nach %1 verschoben werden."

#: src/core/NoteStore.cpp
msgid "The workspace's folder could not be kept."
msgstr "Der Ordner des Arbeitsbereichs konnte nicht gespeichert werden."

#: src/core/NoteStore.cpp
msgid "This folder was kept by a newer %1, so nothing in it is changed here."
msgstr "Dieser Ordner wurde von einer neueren Version von %1 gespeichert, daher wird hier nichts darin geändert."

#: src/core/NoteStore.cpp
msgid "The note could not be moved to the trash."
msgstr "Die Notiz konnte nicht in den Papierkorb verschoben werden."

#: src/core/NoteStore.cpp
msgid "The note could not be brought back from the trash."
msgstr "Die Notiz konnte nicht aus dem Papierkorb zurückgeholt werden."

#: src/core/Welcome.cpp
msgctxt "@info welcome note's first line, its title"
msgid "Welcome to %1"
msgstr "Willkommen bei %1"

#: src/core/Welcome.cpp
msgctxt "@info welcome note"
msgid "Write anything here. It's kept as you type, with nothing to save."
msgstr "Schreiben Sie hier, was Sie möchten. Es wird beim Tippen gespeichert, Sie müssen nichts sichern."

#: src/core/Welcome.cpp
msgctxt "@info welcome note"
msgid "A new note sticks to the window you were using, like a sticky on a page. Tap the dot on that window's title bar to bring it back."
msgstr "Eine neue Notiz haftet an dem Fenster, das Sie gerade benutzt haben, wie ein Haftzettel auf einer Seite. Tippen Sie auf den Punkt in der Titelleiste dieses Fensters, um sie zurückzuholen."

#: src/core/Welcome.cpp
msgctxt "@info welcome note; keep the # and the word after it as one word, which becomes a folder's name, and use the word for the next day that the note listens for"
msgid "Name a day, like tomorrow, and the note offers to remind you. Put # before a word to keep a note in that folder: #ideas. Lines that start with a dash become a checklist."
msgstr "Nennen Sie einen Tag, etwa morgen, und die Notiz bietet an, Sie zu erinnern. Setzen Sie # vor ein Wort, um eine Notiz in diesem Ordner aufzubewahren: #ideen. Zeilen, die mit einem Strich beginnen, werden zur Checkliste."

#: src/core/Welcome.cpp
msgctxt "@info welcome note"
msgid "Tap the grid below to see all your notes. When you're done with this one, tap More, then Remove."
msgstr "Tippen Sie unten auf das Raster, um alle Ihre Notizen zu sehen. Wenn Sie mit dieser fertig sind, tippen Sie auf „Mehr“ und dann auf „Entfernen“."

